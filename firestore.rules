rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasUsernameClaim(userId, username, normalizedUsername) {
      let claimPath = /databases/$(database)/documents/usernames/$(normalizedUsername);
      return existsAfter(claimPath)
        && getAfter(claimPath).data.uid == userId
        && getAfter(claimPath).data.username == username;
    }

    function isFriendshipParticipant(data) {
      return signedIn()
        && request.auth.uid in data.participant_uids;
    }

    function isMatchParticipant(data) {
      return signedIn()
        && request.auth.uid in data.participant_uids;
    }

    match /users/{userId} {
      allow get, list: if true;

      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'username_normalized',
          'avatar_path',
          'wins',
          'losses',
          'total_games',
          'current_streak',
          'friend_wins',
          'category_stats'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'username',
          'username_normalized',
          'avatar_path',
          'wins',
          'losses',
          'total_games',
          'current_streak',
          'friend_wins',
          'category_stats'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 5
        && request.resource.data.username.size() <= 15
        && request.resource.data.username_normalized is string
        && request.resource.data.username_normalized == request.resource.data.username.lower()
        && request.resource.data.username_normalized.matches('^[^/]{5,15}$')
        && request.resource.data.avatar_path is string
        && request.resource.data.wins is int
        && request.resource.data.wins == 0
        && request.resource.data.losses is int
        && request.resource.data.losses == 0
        && request.resource.data.total_games is int
        && request.resource.data.total_games == 0
        && request.resource.data.current_streak is int
        && request.resource.data.current_streak == 0
        && request.resource.data.friend_wins is map
        && request.resource.data.friend_wins.size() == 0
        && request.resource.data.category_stats is map
        && request.resource.data.category_stats.size() == 0
        && hasUsernameClaim(userId, request.resource.data.username, request.resource.data.username_normalized);

      allow update: if ownsUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar_path'])
        && request.resource.data.avatar_path is string;

      allow delete: if false;
    }

    match /usernames/{normalizedUsername} {
      allow get, list: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'username_normalized'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 5
        && request.resource.data.username.size() <= 15
        && request.resource.data.username_normalized == normalizedUsername
        && request.resource.data.username_normalized == request.resource.data.username.lower()
        && request.resource.data.username_normalized.matches('^[^/]{5,15}$');

      allow update: if false;

      // Lets a failed registration release its claim; only possible while no profile exists.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn()
        && resource.data.recipient_uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'recipient_uid',
          'sender_uid',
          'sender',
          'message',
          'action_data',
          'has_actions',
          'is_read',
          'created_at',
          'expires_at'
        ])
        && request.resource.data.keys().hasAll([
          'recipient_uid',
          'sender_uid',
          'message',
          'is_read',
          'created_at'
        ])
        && request.resource.data.sender_uid == request.auth.uid
        && request.resource.data.recipient_uid is string
        && request.resource.data.recipient_uid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipient_uid))
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.is_read == false
        && (request.resource.data.created_at is timestamp || request.resource.data.created_at is number)
        && (!request.resource.data.keys().hasAny(['sender']) || (request.resource.data.sender is string
          && (request.resource.data.sender == 'System'
            || request.resource.data.sender == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username)))
        && (!request.resource.data.keys().hasAny(['action_data']) || request.resource.data.action_data is map)
        && (!request.resource.data.keys().hasAny(['has_actions']) || request.resource.data.has_actions is bool)
        && (!request.resource.data.keys().hasAny(['expires_at']) || (request.resource.data.expires_at is timestamp || request.resource.data.expires_at is number));

      allow update: if signedIn()
        && resource.data.recipient_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])
        && request.resource.data.is_read is bool;

      allow delete: if signedIn()
        && resource.data.recipient_uid == request.auth.uid;
    }

    match /friendships/{pairId} {
      allow get: if signedIn() && (resource == null || isFriendshipParticipant(resource.data));
      allow list: if isFriendshipParticipant(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participant_uids', 'created_at'])
        && request.resource.data.participant_uids is list
        && request.resource.data.participant_uids.size() == 2
        && request.resource.data.participant_uids[0] is string
        && request.resource.data.participant_uids[1] is string
        && request.resource.data.participant_uids[0] < request.resource.data.participant_uids[1]
        && pairId == request.resource.data.participant_uids[0] + '_' + request.resource.data.participant_uids[1]
        && request.auth.uid in request.resource.data.participant_uids
        && request.resource.data.participant_uids[0] != request.resource.data.participant_uids[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participant_uids[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participant_uids[1]))
        && (request.resource.data.created_at is timestamp || request.resource.data.created_at is number);

      allow update: if false;
      allow delete: if isFriendshipParticipant(resource.data);
    }

    match /matches/{matchId} {
      allow get: if signedIn() && (resource == null || isMatchParticipant(resource.data));
      allow list: if isMatchParticipant(resource.data);

      allow create: if signedIn()
        && request.resource.data.match_id == matchId
        && request.resource.data.participant_uids is list
        && request.resource.data.participant_uids.size() == 2
        && request.auth.uid in request.resource.data.participant_uids
        && request.resource.data.participant_uids[0] != request.resource.data.participant_uids[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participant_uids[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participant_uids[1]))
        && request.resource.data.stats_processed == false;

      allow update: if isMatchParticipant(resource.data)
        && request.resource.data.match_id == matchId
        && request.resource.data.participant_uids == resource.data.participant_uids
        && request.resource.data.stats_processed == resource.data.stats_processed;

      allow delete: if isMatchParticipant(resource.data);
    }
  }
}
