; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="quizduell"
run/main_scene="uid://mt4cflygcn3b"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GlobalSignalBus="*res://autoload/global_signal_bus.gd"
TransitionManager="*res://autoload/transition_manager.gd"
TriviaQuestionService="*res://autoload/trivia_question_service.gd"
Firebase="*uid://cvb26atjckwlq"
GoogleSignInService="*res://autoload/google_sign_in_service.gd"
UserDatabase="*res://autoload/user_database.gd"
LocalCache="*res://autoload/local_cache.gd"
Utils="*res://autoload/utils.gd"
LiveUpdateService="*res://autoload/live_update_service.gd"

[display]

window/size/viewport_width=1179
window/size/viewport_height=2556
window/size/window_width_override=816
window/size/window_height_override=1770
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGoogleSignIn/plugin.cfg", "res://addons/font_auto_size_labels/plugin.cfg", "res://addons/godot-firebase/plugin.cfg")

[firebase]

runtime_mode="emulator"
emulator_project_id="demo-quizbattles"
emulator_host="127.0.0.1"
functions_region="us-central1"
emulators/ports/authentication=9099
emulators/ports/firestore=8080
emulators/ports/functions=5001

[google_sign_in]

web_client_id="604709629820-9pq2md3ucerhiiljctgk39sqv75v1d8d.apps.googleusercontent.com"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://localization/ui_translations.en.translation", "res://localization/ui_translations.de.translation", "res://localization/ui_translations.zh_TW.translation")
locale/locale_filter=[1, ["en", "de", "zh_TW"]]
